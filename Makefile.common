# By the host OS
ifeq ($(HOST_OS),win32)
SOURCES_UTIL   += $(SOURCES_UTIL_WIN32)
SOURCES_COMMON += $(SOURCES_COMMON_WIN32)
SOURCES_SYSTEM += $(SOURCES_SYSTEM_WIN32)
else
SOURCES_UTIL   += $(SOURCES_UTIL_POSIX)
SOURCES_COMMON += $(SOURCES_COMMON_POSIX)
SOURCES_SYSTEM += $(SOURCES_SYSTEM_POSIX)
endif
