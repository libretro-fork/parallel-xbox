# What the xemu libretro core is made of, for the Makefile: the sources by
# the flags they are compiled with, and those flags. QEMU's build makes some
# of its sources (QAPI, trace points, config headers): they are in
# libretro/gen, made by meson for the core (libretro/gen/README.md).

GEN_DIR := $(CORE_DIR)/libretro/gen

# --- Flags -----------------------------------------------------------------

# What every part of QEMU is built with
QEMU_INCFLAGS := \
	-I$(GEN_DIR) -I$(CORE_DIR) -I$(CORE_DIR)/libretro-common/include \
	-I$(GEN_DIR)/qapi -I$(GEN_DIR)/trace -I$(GEN_DIR)/ui -I$(GEN_DIR)/data \
	-I$(GEN_DIR)/block \
	$(OS_INCFLAGS) \
	-iquote $(GEN_DIR) -iquote $(CORE_DIR) -iquote $(CORE_DIR)/include \
	-iquote $(CORE_DIR)/host/include/$(HOST_INCLUDE_ARCH) \
	-iquote $(CORE_DIR)/host/include/generic \
	-iquote $(CORE_DIR)/tcg/$(TCG_ARCH)

QEMU_DEFINES := -DLIBRETRO=1 -DXBOX=1 -D_GNU_SOURCE -D_FILE_OFFSET_BITS=64 \
	-D_LARGEFILE_SOURCE -DLIBSLIRP_STATIC -DEPOXY_PUBLIC=extern \
	-DGLIB_STATIC_COMPILATION -DGIO_STATIC_COMPILATION \
	-DGMODULE_STATIC_COMPILATION -DGOBJECT_STATIC_COMPILATION

QEMU_WARNINGS := -Wall -Wempty-body -Wendif-labels -Wexpansion-to-defined \
	-Wformat-security -Wformat-y2k -Wignored-qualifiers \
	-Wimplicit-fallthrough=2 -Winit-self -Wmissing-format-attribute \
	-Wmissing-prototypes -Wnested-externs -Wold-style-declaration \
	-Wold-style-definition -Wredundant-decls -Wshadow=local \
	-Wstrict-prototypes -Wtype-limits -Wwrite-strings \
	-Wno-missing-include-dirs -Wno-psabi -Wno-shift-negative-value

# CONFIG_DSP_JIT is not in the pregenerated config-host.h: it comes with
# DSP_JIT_CFLAGS when the core has the JIT
QEMU_CFLAGS := -std=gnu11 -fno-strict-aliasing -fno-common -fwrapv \
	$(QEMU_WARNINGS) $(QEMU_DEFINES) $(OS_CFLAGS) $(QEMU_INCFLAGS) \
	$(DEPS_CFLAGS) $(DSP_JIT_CFLAGS)

XXHASH_DEFINES := -DXXH_FORCE_ALIGN_CHECK=0 -DXXH_NO_INLINE_HINTS=1 \
	-DXXH_CPU_LITTLE_ENDIAN=1
VULKAN_INCFLAGS := -DVK_NO_PROTOTYPES -I$(CORE_DIR)/deps/volk \
	-I$(CORE_DIR)/deps/VulkanMemoryAllocator/include \
	-I$(CORE_DIR)/deps/SPIRV-Reflect -I$(CORE_DIR)/deps/nv2a_vsh_cpu/src

# By the sources' groups below
CFLAGS_UTIL := $(QEMU_CFLAGS) -I$(CORE_DIR)/deps/xxhash $(XXHASH_DEFINES) \
	-DXXH_STATIC_LINKING_ONLY
CFLAGS_COMMON := $(QEMU_CFLAGS)
CFLAGS_SYSTEM := $(QEMU_CFLAGS) -DCONFIG_SOFTMMU -DCOMPILING_SYSTEM_VS_USER
CFLAGS_TARGET := $(QEMU_CFLAGS) -I$(CORE_DIR)/target/i386 \
	-I$(CORE_DIR)/hw/xbox/nv2a/pgraph/thirdparty/gloffscreen \
	$(VULKAN_INCFLAGS) -DCOMPILING_PER_TARGET \
	-DCONFIG_TARGET=\"i386-softmmu-config-target.h\" \
	-DCONFIG_DEVICES=\"i386-softmmu-config-devices.h\"
CFLAGS_DSP := $(QEMU_CFLAGS) -I$(CORE_DIR)/hw/xbox/mcpx/apu/dsp \
	-I$(CORE_DIR)/hw/xbox/mcpx/apu/dsp/interp
CFLAGS_GLOFF := $(QEMU_CFLAGS) -I$(CORE_DIR)/hw/xbox/nv2a/pgraph/thirdparty
CFLAGS_LRCOMMON := -I$(CORE_DIR)/libretro-common/include -w
CFLAGS_XXHASH := -I$(CORE_DIR)/deps/xxhash $(XXHASH_DEFINES)
CFLAGS_VOLK := -I$(CORE_DIR)/deps/volk -DVK_NO_PROTOTYPES $(OS_CFLAGS) \
	$(DEPS_CFLAGS)
CFLAGS_SPIRV_REFLECT := -I$(CORE_DIR)/deps/SPIRV-Reflect
CFLAGS_VSH := -I$(CORE_DIR)/deps/nv2a_vsh_cpu/src
CXXFLAGS_VMA := -std=c++17 -I$(CORE_DIR)/thirdparty $(VULKAN_INCFLAGS) \
	-DVMA_STATIC_VULKAN_FUNCTIONS=0 -DVMA_DYNAMIC_VULKAN_FUNCTIONS=0 \
	$(OS_CFLAGS) $(DEPS_CFLAGS)

# --- Sources ---------------------------------------------------------------

# By the host's CPU
ifeq ($(TCG_ARCH),aarch64)
SOURCES_HOST := $(CORE_DIR)/util/cpuinfo-aarch64.c
else
SOURCES_HOST := $(CORE_DIR)/util/cpuinfo-i386.c
endif

# The APU DSP's JIT, on the prebuilt dsp56300 library; without it the
# interpreter stands in (dsp_jit_stub.c)
ifeq ($(HAVE_DSP_JIT),1)
SOURCES_DSP_JIT := $(CORE_DIR)/hw/xbox/mcpx/apu/dsp/dsp_jit.c
else
SOURCES_DSP_JIT := $(CORE_DIR)/hw/xbox/mcpx/apu/dsp/dsp_jit_stub.c
endif

# The data files the core carries
SOURCES_DATA_ASM := $(CORE_DIR)/libretro/data.S

# QEMU's utility library and the generated QAPI and trace code
