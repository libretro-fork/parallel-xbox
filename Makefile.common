SOURCES_VSH := \
	$(CORE_DIR)/deps/nv2a_vsh_cpu/src/nv2a_vsh_cpu.c \
	$(CORE_DIR)/deps/nv2a_vsh_cpu/src/nv2a_vsh_disassembler.c \
