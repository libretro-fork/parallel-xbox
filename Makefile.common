SOURCES_VMA_CXX := \
	$(CORE_DIR)/thirdparty/vma.cc \

# Android: Vulkan only, through the frontend's context
ifeq ($(platform),android)
SOURCES_TARGET := $(filter-out $(CORE_DIR)/hw/xbox/nv2a/pgraph/gl/%,$(SOURCES_TARGET))
SOURCES_GLOFF  := $(filter-out %/gloffscreen_libretro.c,$(SOURCES_GLOFF))
SOURCES_TARGET += $(CORE_DIR)/ui/libretro-gl-stubs.c
endif

# By the host OS
ifeq ($(HOST_OS),win32)
SOURCES_UTIL   += $(SOURCES_UTIL_WIN32)
SOURCES_COMMON += $(SOURCES_COMMON_WIN32)
SOURCES_SYSTEM += $(SOURCES_SYSTEM_WIN32)
else
SOURCES_UTIL   += $(SOURCES_UTIL_POSIX)
SOURCES_COMMON += $(SOURCES_COMMON_POSIX)
SOURCES_SYSTEM += $(SOURCES_SYSTEM_POSIX)
ifeq ($(HOST_OS),darwin)
SOURCES_UTIL   += $(SOURCES_UTIL_DARWIN)
SOURCES_COMMON += $(SOURCES_COMMON_DARWIN)
SOURCES_SYSTEM += $(SOURCES_SYSTEM_DARWIN)
else
SOURCES_UTIL   += $(SOURCES_UTIL_LINUX)
SOURCES_COMMON += $(SOURCES_COMMON_LINUX)
SOURCES_SYSTEM += $(SOURCES_SYSTEM_LINUX)
endif
endif
