# The libraries the core links, built from source in deps/. Each is an
# archive, so the core takes only what it uses.
#
#   libslirp 4.9.1, on every platform: built on the core's own GLib
#   (libretro/glib), as the core's code is.
#   libepoxy (WGL; EGL on Android) and the Vulkan headers, on Windows and
#   Android, where the Makefile needs nothing installed but the compiler
#   (MSYS2's MINGW64 gcc or a MinGW-w64 cross compiler; the NDK's clang).

DEPS_DIR := $(CORE_DIR)/deps

# --- libepoxy: WGL on Windows, EGL on Android ---
EPOXY_SOURCES := $(DEPS_DIR)/libepoxy/src/dispatch_common.c \
	$(DEPS_DIR)/libepoxy/src/gl_generated_dispatch.c
EPOXY_CFLAGS := -I$(DEPS_DIR)/libepoxy/include -I$(DEPS_DIR)/libepoxy/src
ifeq ($(platform),android)
EPOXY_SOURCES += $(DEPS_DIR)/libepoxy/src/dispatch_egl.c \
	$(DEPS_DIR)/libepoxy/src/egl_generated_dispatch.c
EPOXY_CFLAGS += -DANDROID
else
EPOXY_SOURCES += $(DEPS_DIR)/libepoxy/src/dispatch_wgl.c \
	$(DEPS_DIR)/libepoxy/src/wgl_generated_dispatch.c
endif

# --- libslirp ---
SLIRP_SOURCES := $(wildcard $(DEPS_DIR)/libslirp/src/*.c)
SLIRP_CFLAGS  := -I$(DEPS_DIR)/libslirp/src -I$(DEPS_DIR)/libslirp/include \
	-I$(CORE_DIR)/libretro/glib \
	-DBUILDING_LIBSLIRP -DLIBSLIRP_STATIC -DG_LOG_DOMAIN=\"Slirp\"
ifeq ($(VENDORED_DEPS),1)
SLIRP_CFLAGS += -DUNICODE -D_UNICODE
endif

# What the core's own sources need of them
DEPS_VENDORED_CFLAGS := -I$(DEPS_DIR)/libslirp/include
ifeq ($(VENDORED_DEPS),1)
DEPS_VENDORED_CFLAGS += -I$(DEPS_DIR)/libepoxy/include \
	-I$(DEPS_DIR)/vulkan-headers
endif

# --- Archives ---
dep_obj = $(patsubst %.c,%.o,$(1))

DEP_LIBS := $(DEPS_DIR)/libslirp.a
ifeq ($(VENDORED_DEPS),1)
DEP_LIBS += $(DEPS_DIR)/libepoxy.a
endif

$(call dep_obj,$(EPOXY_SOURCES)):   GROUP_CFLAGS := $(EPOXY_CFLAGS)
$(call dep_obj,$(SLIRP_SOURCES)):   GROUP_CFLAGS := $(SLIRP_CFLAGS)

$(DEPS_DIR)/libepoxy.a:      $(call dep_obj,$(EPOXY_SOURCES))
$(DEPS_DIR)/libslirp.a:      $(call dep_obj,$(SLIRP_SOURCES))

$(DEP_LIBS):
	rm -f $@
	$(AR) rcs $@ $^

DEP_OBJECTS := $(call dep_obj,$(EPOXY_SOURCES) \
	$(SLIRP_SOURCES))
