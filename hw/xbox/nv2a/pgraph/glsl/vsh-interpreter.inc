/* One authoritative GLSL string; included by vsh-prog.c. */
"// Programmable XVS interpreter; opcode helpers are shared with vsh-prog.c.\n"
"bool irPointWritten=false;\n"
"vec4 irRegs[12];\n"
"vec4 irAttrs[16];\n"
"vec4 irReadReg(uint reg) {\n"
"    if (reg == 12u) return oPos;\n"
"    return irRegs[reg];\n"
"}\n"
"vec4 irReadAttr(uint reg) {\n"
"    return irAttrs[reg];\n"
"}\n"
"vec4 irMask(vec4 oldValue, vec4 newValue, uint mask) {\n"
"    if ((mask & 8u)!=0u) oldValue.x=newValue.x;\n"
"    if ((mask & 4u)!=0u) oldValue.y=newValue.y;\n"
"    if ((mask & 2u)!=0u) oldValue.z=newValue.z;\n"
"    if ((mask & 1u)!=0u) oldValue.w=newValue.w;\n"
"    return oldValue;\n"
"}\n"
"void irWriteReg(uint reg, uint mask, vec4 value) {\n"
"    if(mask==0u)return;\n"
"    if(reg==12u)oPos=irMask(oPos,value,mask);\n"
"    else irRegs[reg]=irMask(irRegs[reg],value,mask);\n"
"}\n"
"void irWriteOutput(uint reg, uint mask, vec4 value) {\n"
"    if(mask==0u)return;\n"
"    switch(reg) {\n"
"    case 0u:oPos=irMask(oPos,value,mask);break;\n"
"    case 3u:oD0=irMask(oD0,value,mask);break;\n"
"    case 4u:oD1=irMask(oD1,value,mask);break;\n"
"    case 5u:\n"
"        // Match the established generator's packed scalar fog write mask.\n"
"        oFog.x=value.x;\n"
"        break;\n"
"    case 6u:if((mask&8u)!=0u)irPointWritten=true;oPts=irMask(oPts,value,mask);break;\n"
"    case 7u:oB0=irMask(oB0,value,mask);break;\n"
"    case 8u:oB1=irMask(oB1,value,mask);break;\n"
"    case 9u:oT0=irMask(oT0,value,mask);break;\n"
"    case 10u:oT1=irMask(oT1,value,mask);break;\n"
"    case 11u:oT2=irMask(oT2,value,mask);break;\n"
"    case 12u:oT3=irMask(oT3,value,mask);break;\n"
"    }\n"
"}\n"
"vec4 irInput(uvec4 token, uint mux, uint reg, uint swizzle, uint negative) {\n"
"    vec4 value;\n"
"    if(mux==1u)value=irReadReg(reg);\n"
"    else if(mux==2u)value=irReadAttr((token.y>>9u)&15u);\n"
"    else {\n"
"        int index=int((token.y>>13u)&255u);\n"
"        if((token.w&2u)!=0u)index+=A0;\n"
"        value=c[index];\n"
"    }\n"
"    value=vec4(value[(swizzle>>6u)&3u],value[(swizzle>>4u)&3u],value[(swizzle>>2u)&3u],value[swizzle&3u]);\n"
"    if(negative!=0u)value=-value;\n"
"    return value;\n"
"}\n"
"vec4 irA(uvec4 t) {\n"
"    return irInput(t,(t.z>>26u)&3u,(t.z>>28u)&15u,t.y&255u,(t.y>>8u)&1u);\n"
"}\n"
"vec4 irC(uvec4 t) {\n"
"    vec4 value=irInput(t,(t.w>>28u)&3u,((t.z&3u)<<2u)|(t.w>>30u),(t.z>>2u)&255u,(t.z>>10u)&1u);\n"
"    uint ilu=(t.y>>25u)&7u;\n"
"    // The scalar ILU selector forces the shared C swizzle for MAC too,\n"
"    // even when the ILU's destination is masked away.\n"
"    if(ilu>=2u && ilu<=6u)value=vec4(value.x);\n"
"    return value;\n"
"}\n"
"vec4 irMac(uvec4 t,uint mac) {\n"
"    vec4 a=irA(t),b=vec4(0.0),cc=vec4(0.0);\n"
"    if(mac!=1u && mac!=3u)\n"
"        b=irInput(t,(t.z>>11u)&3u,(t.z>>13u)&15u,(t.z>>17u)&255u,(t.z>>25u)&1u);\n"
"    if(mac==3u || mac==4u)cc=irC(t);\n"
"    switch(mac) {\n"
"    case 1u:return _MOV(a);\n"
"    case 2u:return _MUL(a,b);\n"
"    case 3u:return _ADD(a,cc);\n"
"    case 4u:return _MAD(a,b,cc);\n"
"    case 5u:return _DP3(a,b);\n"
"    case 6u:return _DPH(a,b);\n"
"    case 7u:return _DP4(a,b);\n"
"    case 8u:return _DST(a,b);\n"
"    case 9u:return _MIN(a,b);\n"
"    case 10u:return _MAX(a,b);\n"
"    case 11u:return _SLT(a,b);\n"
"    case 12u:return _SGE(a,b);\n"
"    }\n"
"    return vec4(0.0);\n"
"}\n"
"vec4 irIlu(uvec4 t,uint ilu) {\n"
"    vec4 cc=irC(t);\n"
"    switch(ilu) {\n"
"    case 1u:return _MOV(cc);\n"
"    case 2u:return _RCP(cc.x);\n"
"    case 3u:return _RCC(cc.x);\n"
"    case 4u:return _RSQ(cc.x);\n"
"    case 5u:return _EXP(cc.x);\n"
"    case 6u:return _LOG(cc.x);\n"
"    case 7u:return _LIT(cc);\n"
"    }\n"
"    return vec4(0.0);\n"
"}\n"
"void irRun() {\n"
"    for(int r=0;r<12;r++)irRegs[r]=vec4(0.0);\n"
"    A0=0;\n"
"    for(int pc=0;pc<136;pc++) {\n"
"        uvec4 t=uvec4(vpCode[pc]);\n"
"        uint mac=(t.y>>21u)&15u, ilu=(t.y>>25u)&7u;\n"
"        uint dst=(t.w>>20u)&15u;\n"
"        uint mm=(t.w>>24u)&15u, im=(t.w>>16u)&15u;\n"
"        uint om=(t.w>>12u)&15u, outreg=(t.w>>3u)&15u;\n"
"        bool omac=((t.w>>2u)&1u)==0u;\n"
"        if(ilu!=0u && dst==1u)mm=0u;\n"
"        vec4 delayed=vec4(0.0);\n"
"        int nextAddress=A0;\n"
"        // Preserve the established generator's evaluation order, including\n"
"        // rereading the R12/oPos mirror after an output write. A single\n"
"        // precomputed ALU result does not match that existing behavior.\n"
"        if(mac!=0u) {\n"
"            if(omac && om!=0u && mac!=13u)irWriteOutput(outreg,om,irMac(t,mac));\n"
"            if(mac==13u) {\n"
"                nextAddress=_ARL(irA(t).x);\n"
"                if(ilu==0u)A0=nextAddress;\n"
"            } else if(mm!=0u) {\n"
"                delayed=irMac(t,mac);\n"
"                if(ilu==0u)irWriteReg(dst,mm,delayed);\n"
"            }\n"
"        }\n"
"        if(ilu!=0u) {\n"
"            // Both reference drivers fold the unrolled RCP(RCP(x)) mirror\n"
"            // round trip to x. Preserve that exact identity rather than\n"
"            // introducing a second rounded reciprocal in this VM loop.\n"
"            uint cr=((t.z&3u)<<2u)|(t.w>>30u);\n"
"            uint component=(t.z>>8u)&3u;\n"
"            bool rcpMirror=ilu==2u && !omac && outreg==0u &&\n"
"                (om&(8u>>component))!=0u && ((t.w>>28u)&3u)==1u && cr==12u;\n"
"            uint wc=(t.z>>2u)&3u;\n"
"            bool litMirror=ilu==7u && !omac && outreg==0u &&\n"
"                ((t.w>>28u)&3u)==1u && cr==12u && (t.z&(1u<<10u))==0u &&\n"
"                (wc==0u || wc==3u) && (om&(8u>>wc))!=0u;\n"
"            float prior=0.0;\n"
"            if(rcpMirror) {\n"
"                prior=irC(t).x;\n"
"                if((t.z&(1u<<10u))!=0u)prior=-prior;\n"
"            }\n"
"            if(!omac && om!=0u)irWriteOutput(outreg,om,irIlu(t,ilu));\n"
"            if(im!=0u) {\n"
"                vec4 result;\n"
"                if(rcpMirror)result=vec4(1.0/(1.0/prior));\n"
"                else if(litMirror) {\n"
"                    // Expose the same literal exponent as the unrolled\n"
"                    // reference. Let each driver optimize this expression;\n"
"                    // manually replacing it with y differs on NVIDIA.\n"
"                    vec4 value=irC(t);\n"
"                    float x=max(value.x,0.0),y=max(value.y,0.0);\n"
"                    result=vec4(1.0,x,x>0.0?exp2(1.0*log2(y)):0.0,1.0);\n"
"                } else result=irIlu(t,ilu);\n"
"                irWriteReg(mac!=0u?1u:dst,im,result);\n"
"            }\n"
"        }\n"
"        if(mac!=0u && ilu!=0u) {\n"
"            if(mac==13u)A0=nextAddress;\n"
"            else if(mm!=0u)irWriteReg(dst,mm,delayed);\n"
"        }\n"
"        if((t.w&1u)!=0u)break;\n"
"    }\n"
"}\n"
